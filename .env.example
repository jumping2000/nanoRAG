# Supported values: production, development, debug
APP_ENV=development
LLM_PROVIDER=ollama #openrouter
LLM_API_KEY=
LLM_BASE_URL=http://host.docker.internal:11434 #https://openrouter.ai/api/v1
LLM_MODEL=minimax-m2.5:cloud #minimax/minimax-m2.5:free
GRAPH_EXTRACTION_ENABLED=true
GRAPH_EXTRACTION_PROVIDER=openrouter
GRAPH_EXTRACTION_API_KEY=sk-or
GRAPH_EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
GRAPH_EXTRACTION_MODEL=
GRAPH_EXTRACTION_MAX_CHUNKS_PER_DOCUMENT=24
GRAPH_EXTRACTION_MIN_CONFIDENCE=0.55
# Graph-augmented retrieval
GRAPH_QUERY_EXPANSION_ENABLED=false
GRAPH_QUERY_EXPANSION_MAX_TERMS=4
GRAPH_RETRIEVAL_ENABLED=false
GRAPH_RETRIEVAL_TOP_K=6
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_HOST=http://ollama:11434
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nanorag_chunks
RETRIEVAL_TOP_K=6
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=80
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# MCP runtime transport for the MCP server used by the backend.
# Values: 'stdio' (backend starts subprocess and communicates over STDIO) or
# 'streamable-http' (MCP listens on HTTP and backend forwards requests).
# Default: stdio
MCP_TRANSPORT=streamable-http
MCP_API_KEY=changeme
# Port the MCP HTTP server listens on (only used when MCP_TRANSPORT=streamable-http).
# Default: 8100
MCP_HTTP_PORT=8100
# Full URL the backend uses to reach the MCP HTTP server.
# Defaults to http://localhost:{MCP_HTTP_PORT}/mcp if not set.
# MCP_HTTP_URL=http://localhost:8100/mcp
