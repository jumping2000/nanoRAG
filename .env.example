# Supported values: production, development, debug
APP_ENV=development
LLM_PROVIDER=ollama #openrouter
LLM_API_KEY=
LLM_BASE_URL=http://host.docker.internal:11434 #https://openrouter.ai/api/v1
LLM_MODEL=minimax-m2.5:cloud #minimax/minimax-m2.5:free
GRAPH_EXTRACTION_ENABLED=true
GRAPH_EXTRACTION_PROVIDER=openrouter
GRAPH_EXTRACTION_API_KEY=sk-or
GRAPH_EXTRACTION_BASE_URL=https://openrouter.ai/api/v1
GRAPH_EXTRACTION_MODEL=
GRAPH_EXTRACTION_MAX_CHUNKS_PER_DOCUMENT=24
GRAPH_EXTRACTION_MIN_CONFIDENCE=0.55
EMBEDDING_PROVIDER=ollama
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_HOST=http://ollama:11434
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=nanorag_chunks
RETRIEVAL_TOP_K=6
CHUNK_SIZE_TOKENS=450
CHUNK_OVERLAP_TOKENS=80
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
MCP_API_KEY=changeme
